<config>
	<parent-provides>
		<service name="IRQ"/>
		<service name="IO_MEM"/>
		<service name="IO_PORT"/>
		<service name="ROM"/>
		<service name="PD"/>
		<service name="RM"/>
		<service name="CPU"/>
		<service name="LOG"/>
		<service name="Report"/>
		<service name="Timer"/>
	</parent-provides>

	<service name="Usb">
		<default-policy> <child name="usb"/> </default-policy> </service>

	<start name="report_rom" caps="100">
		<resource name="RAM" quantum="1M"/>
		<provides>
			<service name="ROM" />
			<service name="Report" />
		</provides>
		<config verbose="no">
		</config>
		<route>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="platform" caps="100" managing_system="yes">
		<resource name="RAM" quantum="6M"/>
		<binary name="imx8mp_platform"/>
		<provides> <service name="Platform"/> </provides>
		<config>
			<policy label="usb -> " info="yes">
				<device name="usb3_0"/>
				<device name="usb3_1"/>
				<device name="usb3_phy0"/>
				<device name="usb3_phy1"/>
				<device name="usb_dwc3_0"/>
				<device name="usb_dwc3_1"/>
			</policy>
		</config>
		<route>
			<service name="ROM" label="devices"> <parent label="devices"/> </service>
			<service name="ROM" label="system"> <parent label="system"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="usb" caps="200">
		<binary name="imx8m_usb_host"/>
		<resource name="RAM" quantum="16M"/>
		<provides> <service name="Usb"/> </provides>
		<route>
			<service name="Platform"> <child name="platform"/> </service>
			<service name="ROM" label="config"> <parent label="usb_host.config"/> </service>
			<service name="ROM" label="devices"> <parent/> </service>
			<service name="ROM" label="dtb"> <parent label="imx8m_usb_host-imx8mp_iot_gate.dtb"/> </service>
			<service name="Report" label="devices"> <parent label="usb_devices"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>
</config>
